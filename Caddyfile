# Redirect www → apex (canonical host). Requires the www DNS record to
# exist (it does), since Caddy obtains a separate certificate for it.
www.sasthragathy.org {
    redir https://sasthragathy.org{uri} permanent
}

# 65.109.131.232.sslip.io {
sasthragathy.org {
    encode gzip

    # Collected static files (public, served straight from the volume).
    handle_path /static/* {
        root * /srv/static
        file_server
    }

    # ── MEDIA: whitelist public folders, gate protected ones, block the rest ──
    # Caddy auto-sorts handle blocks by path specificity, so the nested
    # thumbnails rule below is evaluated before the broader /archive/ rule
    # regardless of the order they appear here.

    # PUBLIC: archive thumbnails (nested inside the protected /archive/ tree).
    handle /media/archive/thumbnails/* {
        root * /srv
        file_server
        header Cache-Control "public, max-age=604800"  # 7 days; safe, public
    }

    # PROTECTED: issue PDFs. The route{} wrapper forces LITERAL ordering:
    # forward_auth runs first, and file_server only runs if Django returned 2xx.
    # Without route{}, Caddy's directive sorting can prevent the file from ever
    # being served even after a successful auth check.
    handle /media/archive/* {
        route {
            forward_auth web:8000 {
                uri /internal/archive-authz
                # Retry the authz subrequest while web restarts (e.g. during
                # a deploy) instead of failing the media request immediately.
                lb_try_duration 60s
                lb_try_interval 500ms
            }
            root * /srv
            file_server
            header Cache-Control "private, no-store"
        }
    }

    # BLOCK: Wagtail documents are served only via the /documents/ serve_view,
    # which enforces collection privacy. The raw path must never be served.
    handle /media/documents/* {
        respond "Not Found" 404
    }

    # PROTECTED: reader feedback uploads (staff or owner only). route{} wrapped
    # for the same auth-then-serve ordering reason as archive above.
    handle /media/postbox_images/* {
        route {
            forward_auth web:8000 {
                uri /internal/postbox-authz
                # Retry the authz subrequest while web restarts (e.g. during
                # a deploy) instead of failing the media request immediately.
                lb_try_duration 60s
                lb_try_interval 500ms
            }
            root * /srv
            file_server
            header Cache-Control "private, no-store"
        }
    }

    # PROTECTED: pre-rendered page images (WebPs), the highest-volume protected
    # asset. Pre-rendered by a django-q task on publish; a 404 here means that
    # task didn't run — fix upstream, the authz view never lazy-renders.
    handle /media/page_cache/* {
        route {
            forward_auth web:8000 {
                uri /internal/page-cache-authz
                # Retry the authz subrequest while web restarts (e.g. during
                # a deploy) instead of failing the media request immediately.
                lb_try_duration 60s
                lb_try_interval 500ms
            }
            root * /srv
            file_server
            header Cache-Control "private, no-store"
        }
    }

    # PUBLIC: Wagtail image originals + renditions (public by design).
    handle /media/images/* {
        root * /srv
        file_server
    }
    handle /media/original_images/* {
        root * /srv
        file_server
    }

    # DEFAULT-DENY: any other /media path is not public until whitelisted above.
    handle /media/* {
        respond "Not Found" 404
    }

    # LOCKDOWN: /internal/* authz endpoints are for Caddy→Django subrequests
    # only (dialled directly at web:8000 over the Docker network). This block
    # 404s any attempt to reach them from the public internet via this host.
    handle /internal/* {
        respond "Not Found" 404
    }

    # Everything else — app routes, the /documents/ serve_view, /reader/, the
    # Wagtail admin, websockets for Channels — goes to gunicorn/uvicorn.
    reverse_proxy web:8000 {
        # Hold and retry requests while the upstream is down (e.g. during a
        # container restart) instead of immediately returning 502.
        lb_try_duration 60s
        lb_try_interval 500ms
    }
}
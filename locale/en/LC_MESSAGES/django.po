msgstr "Didn't receive the code on your phone?"

#: Icarus/templates/account/confirm_login_code.html:108
msgid "പുതിയ കോഡ് അയക്കാൻ അമര്‍ത്തുക"
msgstr "Tap to send a new code"

#: Icarus/templates/account/confirm_login_code.html:115

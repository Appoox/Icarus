msgstr "Change Password"

#: Icarus/templates/account/password_change.html:23
msgid "നിങ്ങളുടെ അക്കൗണ്ട് വിവരങ്ങൾ അപ്ഡേറ്റ് ചെയ്യുക"
msgstr "Update your account details"

#: Icarus/templates/account/password_change.html:81

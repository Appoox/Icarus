#: Icarus/templates/account/login.html:44
#, python-format
msgid "%(counter)s പരാജയപ്പെട്ട ലോഗിൻ ശ്രമം."
msgid_plural "%(counter)s പരാജയപ്പെട്ട ലോഗിൻ ശ്രമങ്ങൾ."
msgstr[0] "%(counter)s failed login attempt."
msgstr[1] "%(counter)s failed login attempts."

#: Icarus/templates/account/login.html:46
msgid "അക്കൗണ്ട് താൽക്കാലികമായി ലോക്ക് ചെയ്തു."
msgstr "Account temporarily locked."

#: Icarus/templates/account/login.html:46
#, python-format
msgid "ഈ ലൊക്കേഷനിൽ/അക്കൗണ്ടിൽ നിന്നുള്ള ആക്സസ് %(duration)s നേരത്തേക്ക് നിയന്ത്രിക്കപ്പെടും."
msgstr "Access from this location/account will be restricted for %(duration)s."

#: Icarus/templates/account/login.html:48
#, python-format
msgid ""
"തുടർച്ചയായ പരാജയങ്ങൾ %(max)s എത്തിയാൽ, %(duration)s നേരത്തേക്ക് ആക്സസ് നിയന്ത്രിക്കപ്പെടും."
msgstr ""
"If consecutive failures reach %(max)s, access will be restricted for "
"%(duration)s."


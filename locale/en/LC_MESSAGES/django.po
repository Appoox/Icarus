#: Icarus/templates/account/login.html:15
msgid "ശാസ്ത്രഗതിയിൽ നിങ്ങളുടെ വായനാ ചരിത്രവും സബ്സ്ക്രിപ്ഷനും ആക്സസ് ചെയ്യാൻ സൈൻ ഇൻ ചെയ്യുക."
msgstr ""
"Sign in to access your reading history and subscription on Sasthragathi."

#: Icarus/templates/account/login.html:35
msgid "അസാധുവായ ഫോൺ/ഇമെയിൽ അല്ലെങ്കിൽ പാസ്‌വേഡ്. വീണ്ടും ശ്രമിക്കുക."
msgstr "Invalid phone/email or password. Please try again."

#: Icarus/templates/account/login.html:43

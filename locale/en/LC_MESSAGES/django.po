msgstr "Back to Profile"

#: Icarus/templates/account/password_reset.html:4
#: Icarus/templates/account/password_reset.html:12
msgid "പാസ്വേഡ് റീസെറ്റ്"
msgstr "Password Reset"

#: Icarus/templates/account/password_reset.html:19
msgid ""
"പാസ്സ്വേഡ് റീസെറ്റ് ചെയ്യുവാനായി നിങ്ങളുടെ ഇമെയിൽ വിലാസം താഴെ നൽകുക. അത് ഞങ്ങൾക്ക് "
"ലഭിച്ചാലുടൻ ഒരു റീസെറ്റ് ലിങ്ക് നിങ്ങളുടെ ഇമെയിലിൽ അയക്കുന്നതാണ്."
msgstr ""
"Enter your email address below to reset your password. As soon as we receive "
"it, a reset link will be sent to your email."

#: Icarus/templates/account/password_reset.html:36
msgid "ഇമെയിൽ വിലാസം"
msgstr "Email Address"

#: Icarus/templates/account/password_reset.html:38
msgid "നിങ്ങളുടെ ഇമെയിൽ നൽകുക"
msgstr "Enter your email"

#: Icarus/templates/account/password_reset.html:42
msgid "എന്റെ പാസ്‍വേര്‍ഡ് റീസെറ്റ് ചെയ്യുക"
msgstr "Reset My Password"

#: Icarus/templates/account/password_reset.html:47
msgid "പാസ്സ്വേഡ് മാറ്റുന്നതുമായി ബന്ധപ്പെട്ട് എന്തെങ്കിലും പ്രശ്നങ്ങളുണ്ടെങ്കിൽ ഞങ്ങളെ ബന്ധപ്പെടുക."
msgstr "If you have any trouble changing your password, contact us."

#: Icarus/templates/account/password_reset.html:49
#: Icarus/templates/account/password_reset_done.html:17
msgid "ലോഗിനിലേക്ക് മടങ്ങുക"
msgstr "Back to login"

#: Icarus/templates/account/password_reset_done.html:4
msgid "പാസ്സ്‌വേഡ് റീസെറ്റ്"
msgstr "Password Reset"

#: Icarus/templates/account/password_reset_done.html:13
msgid "ഇമെയിൽ പരിശോധിക്കുക"
msgstr "Check Your Email"

#: Icarus/templates/account/password_reset_done.html:15
msgid ""
"നിങ്ങളുടെ ഇമെയിലിലേക്ക് ഞങ്ങൾ ഒരു പാസ്‌സ്‌വേഡ് റീസെറ്റ് ലിങ്ക് അയച്ചിട്ടുണ്ട്. അത് ഉടൻ മെയിൽ "
"ബോക്സിൽ കാണാൻ കഴിയുന്നില്ലെങ്കിൽ നിങ്ങളുടെ സ്പാം ഫോൾഡർ പരിശോധിക്കുക."
msgstr ""
"We've sent a password reset link to your email. If you don't see it in your "
"inbox soon, check your spam folder."

#: Icarus/templates/account/password_reset_from_key.html:26
msgid ""
"നിങ്ങളുടെ പാസ്‌വേഡ് റീസെറ്റ് ലിങ്ക് അസാധുവാണ്, കാരണം അത് ഇതിനകം ഉപയോഗിക്കപ്പെട്ടതാകാം. "
"ദയവായി പുതിയ പാസ്‌വേഡ് റീസെറ്റ് അഭ്യർത്ഥിക്കുക."
msgstr ""
"Your password reset link is invalid, possibly because it has already been "
"used. Please request a new password reset."

#: Icarus/templates/account/password_reset_from_key.html:29
msgid "പുതിയ പാസ്സ്‌വേഡ് റീസെറ്റ് ലിങ്ക് അഭ്യർത്ഥിക്കുക"
msgstr "Request a new password reset link"

#: Icarus/templates/account/password_reset_from_key.html:31
msgid "നിങ്ങളുടെ പുതിയ പാസ്‌വേഡ് താഴെ നൽകുക."
msgstr "Enter your new password below."

#: Icarus/templates/account/password_reset_from_key.html:83
msgid "പാസ്‍വേഡ് മാറ്റുക"
msgstr "Change Password"


# Copy to .env and fill in real values. Never commit .env.
# On the server the real file lives at /opt/icarus/shared/.env (deploy.sh
# symlinks it into the checkout).

# --- Django -----------------------------------------------------------
# The live site must run the production module. For local development use
# Icarus.settings.dev — and export it in your shell too, because manage.py
# picks the settings module before this file is read.
DJANGO_SETTINGS_MODULE=Icarus.settings.production
DEBUG=False

# SECRET_KEY + SALT_KEY derive the key that encrypts readers' phone numbers
# and addresses. ON A LIVE SITE NEVER CHANGE EITHER: every encrypted field
# becomes unreadable. To rotate SECRET_KEY, move the old value into
# SECRET_KEY_FALLBACKS (comma-separated) and set a new SECRET_KEY.
# Generate new values (fresh installs only) with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
SECRET_KEY_FALLBACKS=
SALT_KEY=change-me

# HMAC key for phone-number logins. Never change it on a live site.
PHONE_HASH_KEY=change-me

# Comma-separated. Defaults (in base.py) are the sasthragathy.org hosts.
# ALLOWED_HOSTS=sasthragathy.org,www.sasthragathy.org
# CSRF_TRUSTED_ORIGINS=https://sasthragathy.org,https://www.sasthragathy.org

# Absolute URL used in emails (defaults to https://sasthragathy.org).
# BASE_URL=https://sasthragathy.org

# Mock checkout that grants paid plans without payment. Development only;
# the production settings module ignores it.
MOCK_PAYMENTS_ENABLED=False

# Development only: Icarus.settings.dev prints all mail to the terminal and
# ignores EMAIL_BACKEND below, so a copy of the live database can't email real
# readers. To really send (e.g. to a local mail catcher), set this:
# DEV_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# --- Email (password resets, newsletters) -----------------------------
# Without these, mail is printed to the container log instead of sent.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ശാസ്ത്രഗതി <noreply@sasthragathy.org>

# --- Database ---------------------------------------------------------
# Read by the `db` service (to initialise itself) and used by
# docker-compose.yml to build DATABASE_URL for `web` and `qcluster`.
POSTGRES_NAME=icarus
POSTGRES_USER=icarus
POSTGRES_PASSWORD=change-me
BOUNCER_ADMIN_PASSWORD=change-me

# --- Optional ---------------------------------------------------------
# LOG_LEVEL=INFO
# WEB_MEM_LIMIT=3g            # docker-compose memory caps
# QCLUSTER_MEM_LIMIT=4g
# FREE_ARTICLE_LIMIT=3
# EMBEDDING_DIM=1024          # must match the_librarian's vector column
# EMBEDDING_MODEL_NAME=all-mpnet-base-v2
# GOOGLE_CREDENTIALS_JSON=/opt/icarus/shared/google_credentials.json

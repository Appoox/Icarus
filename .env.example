# Copy to .env and fill in real values. Add .env to .gitignore - never commit it.
#
# IMPORTANT: your Dockerfile runs `collectstatic` at BUILD time. Values in
# .env are only injected at container *run* time (via env_file / environment
# in docker-compose.yml) - they are NOT automatically available during
# `docker compose build`. If settings.py requires any of these to import
# (e.g. via environs with no default), export them in your shell first:
#
#   set -a; source .env; set +a; docker compose build
#
# or convert the required ones to Dockerfile ARG/ENV build args instead.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=Icarus.settings.production
DJANGO_ALLOWED_HOSTS=your-domain.example

# --- Database ---
# Read by the `db` service (to initialise itself) and used by
# docker-compose.yml to build DATABASE_URL / DB_HOST / DB_PORT for `web`.
POSTGRES_DB=icarus
POSTGRES_USER=icarus
POSTGRES_PASSWORD=change-me
